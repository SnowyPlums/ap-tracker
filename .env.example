# PostgreSQL connection for the new FastAPI backend.
# Use the Unraid server address when PostgreSQL is a separate container.
# URL-encode special password characters, e.g. @ becomes %40 and $ becomes %24.
AP_TRACKER_DATABASE_URL=postgresql+asyncpg://ap_tracker:password@192.168.1.50:5432/ap_tracker
AP_TRACKER_SECRET_KEY=replace-this-secret
AP_TRACKER_CORS_ORIGINS=http://localhost:3000
AP_TRACKER_ENVIRONMENT=development
# For direct LAN access, use http://serverip:8000.
# For one-domain Nginx/Cloudflare routing, leave this empty and proxy /api
# and /ws to the API container.
AP_TRACKER_PUBLIC_API_URL=http://localhost:8000
